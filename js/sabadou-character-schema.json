{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resposta com expressão do Sabadou",
  "description": "Contrato da conversa com IA. O texto é exibido como texto e o gesto é escolhido de uma lista permitida; não executa comandos gerados pela IA.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "gesture"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 360
    },
    "gesture": {
      "type": "string",
      "enum": [
        "idle",
        "talk",
        "explain",
        "explain_steps",
        "explain_carefully",
        "present",
        "present_left",
        "present_right",
        "point",
        "point_left",
        "point_up",
        "point_down",
        "wave",
        "wave_both",
        "welcome",
        "goodbye",
        "yes",
        "nod_small",
        "no",
        "unsure",
        "think",
        "ponder",
        "curious",
        "idea",
        "surprised",
        "amazed",
        "happy",
        "laugh",
        "celebrate",
        "cheer",
        "victory",
        "proud",
        "grateful",
        "bow",
        "applaud",
        "encourage",
        "reassure",
        "empathy",
        "sorry",
        "disappointed",
        "confused",
        "embarrassed",
        "shy",
        "patient",
        "listening",
        "attentive",
        "respectful",
        "careful",
        "playful",
        "confident"
      ]
    },
    "sequence": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "idle",
          "talk",
          "explain",
          "explain_steps",
          "explain_carefully",
          "present",
          "present_left",
          "present_right",
          "point",
          "point_left",
          "point_up",
          "point_down",
          "wave",
          "wave_both",
          "welcome",
          "goodbye",
          "yes",
          "nod_small",
          "no",
          "unsure",
          "think",
          "ponder",
          "curious",
          "idea",
          "surprised",
          "amazed",
          "happy",
          "laugh",
          "celebrate",
          "cheer",
          "victory",
          "proud",
          "grateful",
          "bow",
          "applaud",
          "encourage",
          "reassure",
          "empathy",
          "sorry",
          "disappointed",
          "confused",
          "embarrassed",
          "shy",
          "patient",
          "listening",
          "attentive",
          "respectful",
          "careful",
          "playful",
          "confident"
        ]
      }
    },
    "moves": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "joint",
          "at",
          "x",
          "y",
          "z"
        ],
        "properties": {
          "joint": {
            "type": "string",
            "enum": [
              "Hips",
              "Spine",
              "Spine1",
              "Spine2",
              "Neck",
              "Head",
              "LeftShoulder",
              "LeftArm",
              "LeftForeArm",
              "LeftHand",
              "RightShoulder",
              "RightArm",
              "RightForeArm",
              "RightHand",
              "LeftUpLeg",
              "LeftLeg",
              "LeftFoot",
              "LeftToeBase",
              "RightUpLeg",
              "RightLeg",
              "RightFoot",
              "RightToeBase",
              "LeftHandThumb1",
              "LeftHandThumb2",
              "LeftHandIndex1",
              "LeftHandIndex2",
              "LeftHandMiddle1",
              "LeftHandMiddle2",
              "LeftHandRing1",
              "LeftHandRing2",
              "RightHandThumb1",
              "RightHandThumb2",
              "RightHandIndex1",
              "RightHandIndex2",
              "RightHandMiddle1",
              "RightHandMiddle2",
              "RightHandRing1",
              "RightHandRing2"
            ]
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          }
        }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mouthOpen",
        "mouthRound"
      ],
      "properties": {
        "mouthOpen": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "mouthRound": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.65
        }
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "left": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z",
            "roll"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -0.6,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": -0.95,
              "maximum": 1
            },
            "z": {
              "type": "number",
              "minimum": -0.1,
              "maximum": 1
            },
            "roll": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          }
        },
        "right": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z",
            "roll"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -0.6,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": -0.95,
              "maximum": 1
            },
            "z": {
              "type": "number",
              "minimum": -0.1,
              "maximum": 1
            },
            "roll": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          }
        }
      }
    },
    "hands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "left": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pose",
            "thumb",
            "index",
            "middle",
            "ring"
          ],
          "properties": {
            "pose": {
              "type": "string",
              "enum": [
                "free",
                "thumbs_up"
              ]
            },
            "thumb": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "index": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "middle": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ring": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "right": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pose",
            "thumb",
            "index",
            "middle",
            "ring"
          ],
          "properties": {
            "pose": {
              "type": "string",
              "enum": [
                "free",
                "thumbs_up"
              ]
            },
            "thumb": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "index": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "middle": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ring": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "energy",
        "tempo"
      ],
      "properties": {
        "energy": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 1
        },
        "tempo": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.6
        }
      }
    }
  }
}
